---
import { site } from '../lib/config.mjs';
import Icon from './Icon.astro';
const { services } = site;
---
<section id={services.id} class="section-space" aria-labelledby={`${services.id}-heading`}>
  <div class="shell">
    <div class="section-intro">
      <div>
        <p class="eyebrow">{services.eyebrow}</p>
        <h2 id={`${services.id}-heading`} class="section-heading mt-4">{services.title}</h2>
      </div>
      <p class="max-w-lg leading-relaxed text-muted">{services.intro}</p>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {services.items.map((service, index) => (
        <article id={service.id} data-service class:list={['service-card group flex flex-col rounded-card border border-border bg-surface p-6 sm:p-8', { 'md:col-span-2': index === services.items.length - 1 && services.items.length % 2 === 1 }]} aria-labelledby={`${service.id}-heading`}>
          <div class="flex items-center justify-between gap-4">
            <span class="grid size-12 place-items-center rounded-button border border-accent/20 bg-accent/5 text-accent"><Icon name={service.icon} /></span>
            <span class="font-mono text-xs text-muted">{services.capabilityLabel} / {String(index + 1).padStart(2, '0')}</span>
          </div>
          <h3 id={`${service.id}-heading`} class="mt-6 text-xl font-semibold leading-snug tracking-tight sm:text-2xl"><a class="hover:text-accent" href={service.href}>{service.title}</a></h3>
          <p class="mt-4 max-w-4xl flex-1 text-sm leading-7 text-muted">{service.description}</p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {service.tags.map((tag) => <li class="rounded-full border border-border px-3 py-1.5 text-xs text-muted">{tag}</li>)}
          </ul>
          <a class="mt-6 inline-flex min-h-11 items-center gap-3 self-start text-sm font-medium text-accent" href={service.href} aria-label={`${services.ctaLabel}: ${service.title}`}>
            {services.ctaLabel}<Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>