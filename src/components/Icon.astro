---
const paths = {
  terminal: ['M4 5h16v14H4z', 'm8 9 3 3-3 3', 'M13 15h3'],
  layers: ['m12 3 10 5-10 5L2 8Z', 'm2 12 10 5 10-5', 'm2 16 10 5 10-5'],
  compass: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18', 'm16 8-2 6-6 2 2-6Z'],
  target: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18', 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10', 'M12 11v2', 'M11 12h2'],
  search: ['M10.5 3a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15', 'm16 16 5 5', 'm7 10 2.5 2.5 4-4'],
  arrow: ['M4 12h16', 'm14 6 6 6-6 6'],
  shield: ['m12 3 8 3v6c0 5-4 8-8 10-4-2-8-5-8-10V6Z', 'm8 12 3 3 5-6'],
  check: ['m5 12 4 4L19 6'],
};

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className = 'size-6' } = Astro.props;
---
<svg class={className} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name].map((path) => <path d={path} />)}
</svg>